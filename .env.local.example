# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real values.

# The canonical public URL of the site (no trailing slash).
# Used for sitemap, robots.txt, canonical tags, and OG metadata.
NEXT_PUBLIC_SITE_URL=https://cat3books.com

# The base URL used for internal API calls or asset paths.
# Usually the same as NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_URL=https://cat3books.com

# The human-readable site name used in metadata and the title template.
NEXT_PUBLIC_SITE_NAME=Cat3 Books

# =============================================================================
# ADMIN / CRM BACKEND  (see docs/admin-setup.md for how to obtain each value)
# =============================================================================

# --- App URLs --------------------------------------------------------------
# Public base URL of the deployed app (used to build links in emails, OAuth
# redirects, tracking pixels, unsubscribe links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host that should be rewritten to /admin by middleware (production subdomain).
NEXT_PUBLIC_ADMIN_HOST=admin.cat3books.com

# --- Supabase --------------------------------------------------------------
# Project URL + anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Token encryption ------------------------------------------------------
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of QuickBooks
# tokens at rest. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- QuickBooks Online -----------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Intuit app.
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" while developing, "production" when live.
QBO_ENVIRONMENT=sandbox
QBO_SCOPES=com.intuit.quickbooks.accounting

# --- Gmail API (Google Workspace sending mailbox) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth redirect used only when minting the refresh token (see docs).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Long-lived refresh token for the sending mailbox.
GOOGLE_REFRESH_TOKEN=
# The Workspace address emails are sent from (e.g. hello@cat3books.com).
GMAIL_SENDER=hello@cat3books.com

# --- Secrets ---------------------------------------------------------------
# Bearer token required to invoke /api/cron/* (set the same value in pg_cron).
# Generate with:  openssl rand -hex 32
CRON_SECRET=
# HMAC key for signing stateless unsubscribe links.
# Generate with:  openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# --- Admin -----------------------------------------------------------------
# The single admin's email (the Supabase Auth user given the `admin` role).
ADMIN_EMAIL=you@cat3books.com
